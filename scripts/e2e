#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SIMULATOR_NAME="${SIMULATOR_NAME:-iPhone 16}"
SCHEME="Feedback Localhost"
DERIVED_DATA_PATH="$REPO_ROOT/ios-app/.build/maestro"
APP_PATH="$DERIVED_DATA_PATH/Build/Products/DebugLocalhost-iphonesimulator/App.app"
MAESTRO_ROOT="$REPO_ROOT/ios-app/.maestro"
DEFAULT_FLOW="manager-create-activity-event"
FLOW_NAME="${1:-$DEFAULT_FLOW}"
API_BASE_URL="http://localhost:8080"
API_HEALTH_URL="http://localhost:8090/actuator/health"
API_HEALTH_TIMEOUT_SECONDS="240"
MAESTRO_DEBUG_OUTPUT="$DERIVED_DATA_PATH/debug"
MAESTRO_TEST_OUTPUT="$DERIVED_DATA_PATH/output"
SKIP_BACKEND_START="${E2E_SKIP_BACKEND_START:-0}"

cleanup() {
  true
}

require_cmd() {
  local cmd="$1"
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "Required command not found: $cmd" >&2
    exit 1
  fi
}

resolve_flow_paths() {
  local requested_flow="$1"
  local candidate

  if [ "$requested_flow" = "all" ]; then
    for flow_dir in "$MAESTRO_ROOT/flows" "$MAESTRO_ROOT/scenarios"; do
      if [ -d "$flow_dir" ]; then
        find "$flow_dir" -maxdepth 1 -name "*.yaml" -type f
      fi
    done | sort
    return 0
  fi

  if [ -f "$requested_flow" ]; then
    cd "$(dirname "$requested_flow")"
    pwd -P | awk -v file="$(basename "$requested_flow")" '{ print $0 "/" file }'
    return 0
  fi

  for candidate in \
    "$MAESTRO_ROOT/flows/$requested_flow" \
    "$MAESTRO_ROOT/flows/$requested_flow.yaml" \
    "$MAESTRO_ROOT/scenarios/$requested_flow" \
    "$MAESTRO_ROOT/scenarios/$requested_flow.yaml" \
    "$MAESTRO_ROOT/$requested_flow" \
    "$MAESTRO_ROOT/$requested_flow.yaml"; do
    if [ -f "$candidate" ]; then
      echo "$candidate"
      return 0
    fi
  done

  echo "Maestro flow not found: $requested_flow" >&2
  echo "Expected a file path, a flow name under ios-app/.maestro/flows, a scenario name under ios-app/.maestro/scenarios, or 'all'." >&2
  return 1
}

seed_command_for_flow() {
  local flow_path="$1"
  local flow_name

  flow_name="$(basename "$flow_path" .yaml)"

  case "$flow_name" in
    debug-auth-seed-manager)
      echo "seed-manager-empty"
      ;;
    manager-create-activity-event)
      echo "seed-manager-empty"
      ;;
    *)
      echo "No seed command configured for Maestro flow: $flow_name" >&2
      echo "Add the flow to seed_command_for_flow in scripts/e2e before running it." >&2
      return 1
      ;;
  esac
}

wait_for_api_health() {
  local timeout_seconds="$1"
  local waited=0
  local interval=2

  while [ "$waited" -lt "$timeout_seconds" ]; do
    if curl --silent "$API_HEALTH_URL" 2>/dev/null | rg -q '"status"\s*:\s*"UP"'; then
      return 0
    fi

    sleep "$interval"
    waited=$((waited + interval))
  done

  echo "API health check failed after ${timeout_seconds}s: $API_HEALTH_URL" >&2
  return 1
}

ensure_booted_simulator() {
  local device_name="$1"
  local udid

  udid="$(
    xcrun simctl list devices available | awk -v name="$device_name" '
      $0 ~ "^[[:space:]]+" name " \\(" {
        if (match($0, /\(([0-9A-F-]+)\)/)) {
          value = substr($0, RSTART + 1, RLENGTH - 2)
          last = value
        }
      }
      END { print last }
    '
  )"

  if [ -z "$udid" ]; then
    echo "Simulator device not found: $device_name" >&2
    exit 1
  fi

  xcrun simctl boot "$udid" >/dev/null 2>&1 || true
  xcrun simctl bootstatus "$udid" -b >/dev/null
  echo "$udid"
}

trap cleanup EXIT

require_cmd docker
require_cmd maestro
require_cmd xcodebuild
require_cmd xcrun
require_cmd curl
require_cmd rg
require_cmd ruby

FLOW_PATHS=()
while IFS= read -r flow_path; do
  FLOW_PATHS+=("$flow_path")
done < <(resolve_flow_paths "$FLOW_NAME")

if [ "${#FLOW_PATHS[@]}" -eq 0 ]; then
  echo "No Maestro flows resolved for: $FLOW_NAME" >&2
  exit 1
fi

cd "$REPO_ROOT"
if [ "$SKIP_BACKEND_START" != "1" ]; then
  ./scripts/run -d
fi
wait_for_api_health "$API_HEALTH_TIMEOUT_SECONDS"
SIMULATOR_UDID="$(ensure_booted_simulator "$SIMULATOR_NAME")"

cd "$REPO_ROOT/ios-app"
xcodebuild \
  -project Feedback.xcodeproj \
  -scheme "$SCHEME" \
  -destination "id=$SIMULATOR_UDID" \
  -derivedDataPath "$DERIVED_DATA_PATH" \
  -skipMacroValidation \
  -skipPackagePluginValidation \
  build

if [ ! -d "$APP_PATH" ]; then
  echo "Built app not found at expected path: $APP_PATH" >&2
  exit 1
fi

xcrun simctl install "$SIMULATOR_UDID" "$APP_PATH"
mkdir -p "$MAESTRO_DEBUG_OUTPUT" "$MAESTRO_TEST_OUTPUT"

for flow_path in "${FLOW_PATHS[@]}"; do
  flow_name="$(basename "$flow_path" .yaml)"
  seed_command="$(seed_command_for_flow "$flow_path")"

  echo "Resetting E2E backend state for: $flow_name"
  API_BASE_URL="$API_BASE_URL" "$REPO_ROOT/scripts/e2e-admin" reset

  maestro_env=()
  if [ -n "$seed_command" ]; then
    echo "Seeding E2E backend state for: $flow_name ($seed_command)"
    e2e_token="$(API_BASE_URL="$API_BASE_URL" "$REPO_ROOT/scripts/e2e-admin" "$seed_command")"
    maestro_env=(-e "E2E_CUSTOM_TOKEN=$e2e_token")
  fi

  echo "Running Maestro flow: $flow_path"
  if [ -n "$seed_command" ]; then
    maestro test \
      --device "$SIMULATOR_UDID" \
      --debug-output "$MAESTRO_DEBUG_OUTPUT" \
      --test-output-dir "$MAESTRO_TEST_OUTPUT" \
      "${maestro_env[@]}" \
      "$flow_path"
  else
    maestro test \
      --device "$SIMULATOR_UDID" \
      --debug-output "$MAESTRO_DEBUG_OUTPUT" \
      --test-output-dir "$MAESTRO_TEST_OUTPUT" \
      "$flow_path"
  fi
done
