#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SIMULATOR_NAME="${SIMULATOR_NAME:-iPhone 16}"
SCHEME="Feedback Localhost"
DERIVED_DATA_PATH="$REPO_ROOT/ios-app/.build/maestro"
APP_PATH="$DERIVED_DATA_PATH/Build/Products/DebugLocalhost-iphonesimulator/App.app"
MAESTRO_FLOW_PATH="$REPO_ROOT/ios-app/.maestro/smoke-launch.yaml"
API_HEALTH_URL="http://localhost:8090/actuator/health"
API_HEALTH_TIMEOUT_SECONDS="240"

cleanup() {
  cd "$REPO_ROOT"
  docker compose down
}

require_cmd() {
  local cmd="$1"
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "Required command not found: $cmd" >&2
    exit 1
  fi
}

wait_for_api_health() {
  local timeout_seconds="$1"
  local waited=0
  local interval=2

  while [ "$waited" -lt "$timeout_seconds" ]; do
    if curl --fail --silent --show-error "$API_HEALTH_URL" | rg -q '"status"\s*:\s*"UP"'; then
      return 0
    fi

    sleep "$interval"
    waited=$((waited + interval))
  done

  echo "API health check failed after ${timeout_seconds}s: $API_HEALTH_URL" >&2
  return 1
}

ensure_booted_simulator() {
  local device_name="$1"
  local udid

  udid="$(xcrun simctl list devices available | rg "$device_name" | head -n1 | sed -E 's/.*\(([-A-F0-9]+)\) \(.*/\1/')"

  if [ -z "$udid" ]; then
    echo "Simulator device not found: $device_name" >&2
    exit 1
  fi

  xcrun simctl boot "$udid" >/dev/null 2>&1 || true
  xcrun simctl bootstatus "$udid" -b
  echo "$udid"
}

trap cleanup EXIT

require_cmd docker
require_cmd maestro
require_cmd xcodebuild
require_cmd xcrun
require_cmd curl
require_cmd rg

cd "$REPO_ROOT"
./scripts/run -d
wait_for_api_health "$API_HEALTH_TIMEOUT_SECONDS"

SIMULATOR_UDID="$(ensure_booted_simulator "$SIMULATOR_NAME")"

cd "$REPO_ROOT/ios-app"
xcodebuild \
  -project Feedback.xcodeproj \
  -scheme "$SCHEME" \
  -destination "id=$SIMULATOR_UDID" \
  -derivedDataPath "$DERIVED_DATA_PATH" \
  build

if [ ! -d "$APP_PATH" ]; then
  echo "Built app not found at expected path: $APP_PATH" >&2
  exit 1
fi

xcrun simctl install "$SIMULATOR_UDID" "$APP_PATH"
maestro test --device "$SIMULATOR_UDID" "$MAESTRO_FLOW_PATH"
