IMAGE_PLATFORM=linux/amd64

SPRING_DOC_API_DOCS_ENABLED=true
SPRING_DOC_SWAGGER_UI_ENABLED=true

# Use a host reachable from Docker containers for Compose runs
# (for example host.docker.internal on Docker Desktop, or your host IP on Linux).
# `localhost` is only correct for direct backend runs on the host.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=feedback_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Managed Supabase Auth. Enable asymmetric ES256 or RS256 signing keys.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server only: needed for account deletion and opt-in local fixture login. Never expose to clients.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backend sends personal team-leader invitations. Configure custom SMTP in Supabase separately for OTP mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
INVITATION_FROM=hello@letsgrow.dk
LETSGROW_APP_URL=https://app.letsgrow.dk
NEXT_PUBLIC_LETSGROW_EARLY_ACCESS_URL=https://form.typeform.com/to/RSs7TZAj

# Firebase remains for push notifications and crash reporting, not user authentication.
FIREBASE_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON_B64=
FEEDBACK_ADMIN_EMAILS=
COOLIFY_MCP_TOKEN=
ZOHO_ACCOUNT_ID=
ZOHO_FOLDER_ID=
ZOHO_MAILBOX_ADDRESS=
ZOHO_OAUTH_REFRESH_TOKEN=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Server-only backend origin for the leader web app (Compose uses http://api:8080).
FEEDBACK_API_ORIGIN=http://localhost:8080
