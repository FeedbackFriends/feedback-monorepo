{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh -lc 'cd \"$(git rev-parse --show-toplevel)\" && exec ios-app/.agents/hooks/swiftlint-fix-changed.sh'"
          }
        ]
      }
    ]
  }
}
