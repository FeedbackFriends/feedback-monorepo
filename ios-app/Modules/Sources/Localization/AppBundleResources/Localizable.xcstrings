  "strings" : {
    "notification_feedback_received_body" : {
      "comment" : "Remote push body. APNs loc-args are strings: 1 = new response count, 2 = user-authored session title. Preserve the order and both %@ types. Count-neutral wording supports 1 and many without converting the server string argument to a numeric plural.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har modtaget %1$@ feedbacksvar på ‘%2$@’."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New feedback for ‘%2$@’ · Responses: %1$@"
          }
        }
      }
    },
